// Copies a strided view of `src` into a strided place in `dst`: Concat,
// Split, Slice (negative strides for negative steps), Expand (stride 0)
// and Transpose, over up to 6 dimensions.
#version 450
#extension GL_GOOGLE_include_directive : require
#include "precision.glsl"
#include "common.glsl"

layout(set = 0, binding = 0, std430) readonly buffer Src { real s[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Dst { real d[]; };

layout(push_constant) uniform Params {
    uint n;
    int src_offset;
    int dst_offset;
    uint rank; // dimensions in use, the innermost last
    uint shape[6];
    int src_strides[6];
    int dst_strides[6];
} p;

void main() {
    uint i = element();
    if (i >= p.n) {
        return;
    }
    uint rest = i;
    int from = p.src_offset;
    int to = p.dst_offset;
    // Unrolled, so the arrays are indexed by constants; only the
    // dimensions in use, and the outermost without a division.
    [[unroll]] for (uint j = 0u; j < 6u; j++) {
        uint k = 5u - j;
        if (j + 1u >= p.rank) {
            from += int(rest) * p.src_strides[k];
            to += int(rest) * p.dst_strides[k];
            break;
        }
        int idx = int(rest % p.shape[k]);
        rest /= p.shape[k];
        from += idx * p.src_strides[k];
        to += idx * p.dst_strides[k];
    }
    d[to] = real(float(s[from]));
}
