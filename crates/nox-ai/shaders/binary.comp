// out = a (op) b, broadcasting NumPy-style over up to 6 dimensions (the
// planner pads shapes; broadcast dimensions have stride 0).
#version 450
#extension GL_GOOGLE_include_directive : require
#include "precision.glsl"
#include "common.glsl"

layout(set = 0, binding = 0, std430) readonly buffer A { real a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { real b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Out { real o[]; };

layout(push_constant) uniform Params {
    uint n;
    uint op; // cpu::BinaryOp
    uint a_offset;
    uint b_offset;
    uint rank; // dimensions in use, the innermost last
    uint shape[6];
    uint a_strides[6];
    uint b_strides[6];
} p;

void main() {
    uint i = element();
    if (i >= p.n) {
        return;
    }
    uint rest = i;
    uint ia = p.a_offset;
    uint ib = p.b_offset;
    // Unrolled, so the arrays are indexed by constants; only the
    // dimensions in use, and the outermost without a division.
    [[unroll]] for (uint k = 0u; k < 6u; k++) {
        uint d = 5u - k;
        if (k + 1u >= p.rank) {
            ia += rest * p.a_strides[d];
            ib += rest * p.b_strides[d];
            break;
        }
        uint idx = rest % p.shape[d];
        rest /= p.shape[d];
        ia += idx * p.a_strides[d];
        ib += idx * p.b_strides[d];
    }
    float x = float(a[ia]);
    float y = float(b[ib]);
    float r;
    switch (p.op) {
    case 0: r = x + y; break;
    case 1: r = x - y; break;
    case 2: r = x * y; break;
    case 3: r = x / y; break;
    default: r = pow(x, y); break;
    }
    o[i] = real(r);
}
