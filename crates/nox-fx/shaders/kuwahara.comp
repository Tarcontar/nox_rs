// Generalized Kuwahara filter (painterly): around each pixel, the mean and
// variance of eight sectors of a disc; the result is their means weighted
// towards the flattest sectors (1 / (1 + σ^sharpness)), which smooths
// regions while keeping their edges. Large radii take every `step`th
// pixel.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#include "common.glsl"

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    uvec2 size;
    int radius;
    int step;
    float sharpness;
} p;

const int SECTORS = 8;
const float PI = 3.14159265;

void main() {
    ivec2 pos;
    if (!pixel(p.size, pos)) {
        return;
    }
    ivec2 last = ivec2(p.size) - 1;
    vec3 mean[SECTORS];
    vec3 square[SECTORS];
    float count[SECTORS];
    [[unroll]] for (int s = 0; s < SECTORS; s++) {
        mean[s] = vec3(0.0);
        square[s] = vec3(0.0);
        count[s] = 0.0;
    }
    vec4 center = imageLoad(src, pos);
    float r2 = float(p.radius * p.radius);
    for (int y = -p.radius; y <= p.radius; y += p.step) {
        for (int x = -p.radius; x <= p.radius; x += p.step) {
            float d2 = float(x * x + y * y);
            if (d2 > r2) {
                continue;
            }
            vec3 c = imageLoad(src, clamp(pos + ivec2(x, y), ivec2(0), last)).rgb;
            // The center belongs to every sector.
            if (x == 0 && y == 0) {
                [[unroll]] for (int s = 0; s < SECTORS; s++) {
                    mean[s] += c;
                    square[s] += c * c;
                    count[s] += 1.0;
                }
                continue;
            }
            float angle = atan(float(y), float(x));
            int s = int(floor((angle + PI) / (2.0 * PI) * float(SECTORS))) % SECTORS;
            mean[s] += c;
            square[s] += c * c;
            count[s] += 1.0;
        }
    }
    vec3 sum = vec3(0.0);
    float weights = 0.0;
    [[unroll]] for (int s = 0; s < SECTORS; s++) {
        vec3 m = mean[s] / count[s];
        vec3 v = abs(square[s] / count[s] - m * m);
        // Perceptual: compare variances of roughly perceptual values.
        float sigma = sqrt(v.r + v.g + v.b) / (dot(m, vec3(0.333)) + 0.05);
        float w = 1.0 / (1.0 + pow(sigma * 10.0, p.sharpness));
        sum += m * w;
        weights += w;
    }
    imageStore(dst, pos, vec4(sum / weights, center.a));
}
