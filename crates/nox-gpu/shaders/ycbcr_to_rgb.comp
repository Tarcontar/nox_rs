// Converts decoded video planes to display-referred R'G'B' (RGBA8), or with
// WORKING defined, to linear working-space RGB (RGBA32F) for compositing.
//
// Planes are sampled as UNORM textures; the push-constant matrix (built by
// nox-color) maps the normalized texel values straight to R'G'B', so range,
// bit depth and Y'CbCr coefficients need no special cases here.
#version 450
#extension GL_GOOGLE_include_directive : require

#include "color.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

#ifdef WORKING
layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D out_image;
#else
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D out_image;
#endif
layout(set = 0, binding = 1) uniform sampler2D plane0;
layout(set = 0, binding = 2) uniform sampler2D plane1;
layout(set = 0, binding = 3) uniform sampler2D plane2;

layout(push_constant) uniform Params {
    vec4 row0;
    vec4 row1;
    vec4 row2;
    // Chroma sample position relative to center-sited, in normalized
    // coordinates (H.273 chroma sample location).
    vec2 chroma_offset;
    // Picture size / image size: decoded images may be padded (e.g. 1088
    // rows for 1080p), and only the picture area is sampled.
    vec2 uv_scale;
    ivec2 size; // output size
    int layout_mode;
    int swap_chroma;
    // HDR to SDR (see nox_color::hdr, which this mirrors): signal encoding,
    // source primaries and the content's peak in nits.
    int hdr_mode;
    int hdr_gamut;
    float source_peak;
    // SDR sources into the working space (nox_color::InputTransform).
    int transfer;
    int primaries;
    // For HDR outputs: HDR sources keep their light (relative to SDR
    // white) instead of being tone-mapped (InputTransform::apply_hdr).
    int keep_hdr;
    // How the picture is turned for display (nox_gpu::Orientation):
    // clockwise quarter turns in bits 0-1, mirrored left to right in bit 2.
    // The output is in display orientation.
    int orientation;
} p;

const int HDR_NONE = 0;
const int HDR_PQ = 1;
const int HDR_HLG = 2;
const float SDR_WHITE = 203.0;

const float PQ_M1 = 2610.0 / 16384.0;
const float PQ_M2 = 2523.0 / 4096.0 * 128.0;
const float PQ_C1 = 3424.0 / 4096.0;
const float PQ_C2 = 2413.0 / 4096.0 * 32.0;
const float PQ_C3 = 2392.0 / 4096.0 * 32.0;

// PQ signal to light relative to 10000 nits, and back.
float pq_eotf(float e) {
    float p = pow(clamp(e, 0.0, 1.0), 1.0 / PQ_M2);
    return pow(max(p - PQ_C1, 0.0) / (PQ_C2 - PQ_C3 * p), 1.0 / PQ_M1);
}
float pq_inverse(float l) {
    float y = pow(clamp(l, 0.0, 1.0), PQ_M1);
    return pow((PQ_C1 + PQ_C2 * y) / (1.0 + PQ_C3 * y), PQ_M2);
}

// BT.2390 EETF in PQ space: source peak onto target peak.
float eetf(float nits, float source_peak, float target_peak) {
    if (source_peak <= target_peak) {
        return min(nits, target_peak);
    }
    float source = pq_inverse(source_peak / 10000.0);
    float e1 = pq_inverse(nits / 10000.0) / source;
    float max_lum = pq_inverse(target_peak / 10000.0) / source;
    float knee = 1.5 * max_lum - 0.5;
    float e2 = e1;
    if (e1 >= knee) {
        float t = (min(e1, 1.0) - knee) / (1.0 - knee);
        float t2 = t * t;
        float t3 = t2 * t;
        e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * knee + (t3 - 2.0 * t2 + t) * (1.0 - knee)
            + (-2.0 * t3 + 3.0 * t2) * max_lum;
    }
    return pq_eotf(e2 * source) * 10000.0;
}

vec3 hlg_display_light(vec3 e, vec3 weights) {
    const float A = 0.17883277;
    const float B = 0.28466892;
    const float C = 0.5599107;
    e = clamp(e, 0.0, 1.0);
    vec3 low = e * e / 3.0;
    vec3 high = (exp((e - C) / A) + B) / 12.0;
    vec3 scene = mix(low, high, greaterThan(e, vec3(0.5)));
    float y = dot(weights, scene);
    return scene * 1000.0 * pow(max(y, 1e-6), 0.2);
}

// Rows of the linear conversion to BT.709 (BT.2087 for BT.2020).
mat3 to_bt709(int gamut) {
    if (gamut == 1) {
        return transpose(mat3(
            1.660491, -0.587641, -0.072850,
            -0.124550, 1.132900, -0.008349,
            -0.018151, -0.100579, 1.118730));
    }
    if (gamut == 2) {
        return transpose(mat3(
            1.224940, -0.224940, 0.0,
            -0.042057, 1.042057, 0.0,
            -0.019638, -0.078636, 1.098274));
    }
    return mat3(1.0);
}

// Non-linear HDR R'G'B' to linear BT.709 light relative to SDR white (0–1).
vec3 hdr_to_sdr_linear(vec3 rgb) {
    vec3 light;
    if (p.hdr_mode == HDR_PQ) {
        light = vec3(pq_eotf(rgb.r), pq_eotf(rgb.g), pq_eotf(rgb.b)) * 10000.0;
    } else {
        vec3 weights = p.hdr_gamut == 1 ? vec3(0.2627, 0.6780, 0.0593)
                                        : vec3(0.2126, 0.7152, 0.0722);
        light = hlg_display_light(rgb, weights);
    }
    vec3 linear = max(to_bt709(p.hdr_gamut) * light, 0.0);
    float peak = max(linear.r, max(linear.g, linear.b));
    float scale = peak > 0.0 ? eetf(peak, p.source_peak, SDR_WHITE) / peak : 0.0;
    return clamp(linear * scale / SDR_WHITE, 0.0, 1.0);
}

const int THREE_PLANE = 0; // Y, Cb, Cr (or G, B, R) in separate planes
const int TWO_PLANE = 1;   // Y + interleaved CbCr (NV12, P010, ...)
const int PACKED = 2;      // one RGBA plane
const int ONE_PLANE = 3;   // luma only

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, p.size))) {
        return;
    }
    // All planes are sampled bilinearly at the output pixel center, which
    // scales to the output size (non-square pixels, preview downscaling).
    // At 1:1 this returns the exact texels.
    vec2 shown = (vec2(pos) + 0.5) / vec2(p.size);
    if ((p.orientation & 4) != 0) {
        shown.x = 1.0 - shown.x;
    }
    // Where the shown point is in the stored picture (undoing the turns).
    vec2 stored;
    switch (p.orientation & 3) {
    case 1: stored = vec2(shown.y, 1.0 - shown.x); break;
    case 2: stored = 1.0 - shown; break;
    case 3: stored = vec2(1.0 - shown.y, shown.x); break;
    default: stored = shown; break;
    }
    vec2 uv = stored * p.uv_scale;
    vec2 chroma_uv = uv + p.chroma_offset;

    vec3 samples;
    // Straight (not premultiplied) alpha, as in PNG; formats without alpha
    // read as 1. The compositor blends with it.
    float alpha = 1.0;
    if (p.layout_mode == PACKED) {
        vec4 texel = texture(plane0, uv);
        samples = texel.rgb;
        alpha = texel.a;
    } else {
        float y = texture(plane0, uv).r;
        vec2 c = vec2(0.0);
        if (p.layout_mode == TWO_PLANE) {
            c = texture(plane1, chroma_uv).rg;
        } else if (p.layout_mode == THREE_PLANE) {
            c = vec2(texture(plane1, chroma_uv).r, texture(plane2, chroma_uv).r);
        }
        if (p.swap_chroma != 0) {
            c = c.yx;
        }
        samples = vec3(y, c);
    }

    vec4 v = vec4(samples, 1.0);
    vec3 rgb = clamp(vec3(dot(p.row0, v), dot(p.row1, v), dot(p.row2, v)), 0.0, 1.0);
#ifdef WORKING
    vec3 linear;
    if (p.hdr_mode != HDR_NONE && p.keep_hdr != 0) {
        vec3 light;
        if (p.hdr_mode == HDR_PQ) {
            light = vec3(pq_eotf(rgb.r), pq_eotf(rgb.g), pq_eotf(rgb.b)) * 10000.0;
        } else {
            vec3 weights = p.hdr_gamut == 1 ? vec3(0.2627, 0.6780, 0.0593)
                                            : vec3(0.2126, 0.7152, 0.0722);
            light = hlg_display_light(rgb, weights);
        }
        int gamut = p.hdr_gamut == 1 ? PRIMARIES_BT2020
                  : p.hdr_gamut == 2 ? PRIMARIES_DISPLAYP3
                                     : PRIMARIES_BT709;
        linear = to_working(gamut) * light / SDR_WHITE;
    } else if (p.hdr_mode != HDR_NONE) {
        linear = to_working(PRIMARIES_BT709) * hdr_to_sdr_linear(rgb);
    } else {
        linear = to_working(p.primaries) * eotf(rgb, p.transfer);
    }
    imageStore(out_image, pos, vec4(linear, alpha));
#else
    if (p.hdr_mode != HDR_NONE) {
        rgb = pow(hdr_to_sdr_linear(rgb), vec3(1.0 / 2.4));
    }
    imageStore(out_image, pos, vec4(rgb, alpha));
#endif
}
