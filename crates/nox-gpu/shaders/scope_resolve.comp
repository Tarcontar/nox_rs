// Turns the scopes' counts (scope_count.comp) into images: brightness
// grows with the logarithm of a bin's count, so sparse traces stay visible
// next to dense ones. Straight (not premultiplied) alpha; the GUI draws
// the graticules.
#version 450
#extension GL_GOOGLE_include_directive : require

#include "scope_layout.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D out_image;
layout(set = 0, binding = 1, std430) readonly buffer Counts {
    uint counts[];
};

layout(push_constant) uniform Params {
    int mode;
    // Count shown at full brightness, per mode (from the picture size).
    float full;
} p;

const int WAVEFORM = 0;
const int PARADE = 1;
const int VECTORSCOPE = 2;
const int HISTOGRAM = 3;

float intensity(uint count) {
    return clamp(log(1.0 + float(count)) / log(1.0 + p.full), 0.0, 1.0);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_image);
    if (any(greaterThanEqual(pos, size))) {
        return;
    }
    vec4 color = vec4(0.0);
    if (p.mode == WAVEFORM) {
        float i = intensity(counts[WAVEFORM_OFFSET + pos.y * WAVEFORM_WIDTH + pos.x]);
        color = vec4(0.55, 1.0, 0.6, i);
    } else if (p.mode == PARADE) {
        int part = PARADE_WIDTH / 3;
        vec3 tints[3] = vec3[](vec3(1.0, 0.4, 0.35), vec3(0.45, 1.0, 0.5), vec3(0.45, 0.65, 1.0));
        float i = intensity(counts[PARADE_OFFSET + pos.y * PARADE_WIDTH + pos.x]);
        color = vec4(tints[min(pos.x / part, 2)], i);
    } else if (p.mode == VECTORSCOPE) {
        float i = intensity(counts[VECTOR_OFFSET + pos.y * VECTOR_SIZE + pos.x]);
        // Tinted with the hue at that position (BT.709, mid luma).
        float cb = (float(pos.x) + 0.5) / float(VECTOR_SIZE) - 0.5;
        float cr = 0.5 - (float(pos.y) + 0.5) / float(VECTOR_SIZE);
        vec3 hue = clamp(vec3(0.6 + 1.5748 * cr,
                              0.6 - 0.1873 * cb - 0.4681 * cr,
                              0.6 + 1.8556 * cb), 0.0, 1.0);
        color = vec4(mix(vec3(1.0), hue, 0.5), i);
    } else {
        // Overlaid R, G and B bars growing from the bottom; the largest bin
        // of any channel reaches the top.
        float largest = max(float(counts[HISTOGRAM_MAX_OFFSET]), 1.0);
        float height = float(size.y - 1 - pos.y) / float(size.y - 1);
        vec3 tints[3] = vec3[](vec3(1.0, 0.3, 0.3), vec3(0.3, 1.0, 0.35), vec3(0.35, 0.55, 1.0));
        vec3 sum = vec3(0.0);
        float alpha = 0.0;
        for (int c = 0; c < 3; c++) {
            float bar = float(counts[HISTOGRAM_OFFSET + c * HISTOGRAM_BINS + pos.x]) / largest;
            if (bar > 0.0 && bar >= height) {
                sum += tints[c] * 0.7;
                alpha = 0.85;
            }
        }
        color = vec4(min(sum, vec3(1.0)), alpha);
    }
    imageStore(out_image, pos, color);
}
