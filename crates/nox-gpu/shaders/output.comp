// Writes the accumulated picture (linear working space) to the output
// image, encoded as `encoding` says (encode_output): RGBA8, RGBA16F with
// HALF_FLOAT defined (for the viewer), or RGBA16 with DEEP defined (HDR
// exports read back to the CPU).
#version 450
#extension GL_GOOGLE_include_directive : require

#include "color.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D accum;
#ifdef HALF_FLOAT
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D out_image;
#elif defined(DEEP)
layout(set = 0, binding = 1, rgba16) uniform writeonly image2D out_image;
#else
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_image;
#endif

layout(push_constant) uniform Params {
    ivec2 size;
    int encoding;
} p;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, p.size))) {
        return;
    }
    imageStore(out_image, pos, vec4(encode_output(imageLoad(accum, pos).rgb, p.encoding), 1.0));
}
