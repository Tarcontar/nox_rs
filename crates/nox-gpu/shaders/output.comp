// Writes the accumulated picture to the 8-bit output image.
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D accum;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_image;

layout(push_constant) uniform Params {
    ivec2 size;
} p;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, p.size))) {
        return;
    }
    imageStore(out_image, pos, vec4(clamp(imageLoad(accum, pos).rgb, 0.0, 1.0), 1.0));
}
