<?xml version="1.0" encoding="UTF-8"?>
<interface domain="nox">
  <!-- Right-click menu of timeline clips; the actions work on the selection. -->
  <menu id="clip_menu">
    <section>
      <submenu>
        <attribute name="label" translatable="yes">Opacity</attribute>
        <item>
          <attribute name="label">100%</attribute>
          <attribute name="action">win.clip-opacity</attribute>
          <attribute name="target" type="d">1.0</attribute>
        </item>
        <item>
          <attribute name="label">75%</attribute>
          <attribute name="action">win.clip-opacity</attribute>
          <attribute name="target" type="d">0.75</attribute>
        </item>
        <item>
          <attribute name="label">50%</attribute>
          <attribute name="action">win.clip-opacity</attribute>
          <attribute name="target" type="d">0.5</attribute>
        </item>
        <item>
          <attribute name="label">25%</attribute>
          <attribute name="action">win.clip-opacity</attribute>
          <attribute name="target" type="d">0.25</attribute>
        </item>
      </submenu>
      <submenu>
        <attribute name="label" translatable="yes">Blend Mode</attribute>
        <item>
          <attribute name="label" translatable="yes" context="blend mode">Normal</attribute>
          <attribute name="action">win.clip-blend</attribute>
          <attribute name="target">normal</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes" context="blend mode">Add</attribute>
          <attribute name="action">win.clip-blend</attribute>
          <attribute name="target">add</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes" context="blend mode">Multiply</attribute>
          <attribute name="action">win.clip-blend</attribute>
          <attribute name="target">multiply</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes" context="blend mode">Screen</attribute>
          <attribute name="action">win.clip-blend</attribute>
          <attribute name="target">screen</attribute>
        </item>
      </submenu>
      <submenu>
        <attribute name="label" translatable="yes">Volume</attribute>
        <item>
          <attribute name="label">+6 dB</attribute>
          <attribute name="action">win.clip-volume</attribute>
          <attribute name="target" type="d">2.0</attribute>
        </item>
        <item>
          <attribute name="label">0 dB</attribute>
          <attribute name="action">win.clip-volume</attribute>
          <attribute name="target" type="d">1.0</attribute>
        </item>
        <item>
          <attribute name="label">−6 dB</attribute>
          <attribute name="action">win.clip-volume</attribute>
          <attribute name="target" type="d">0.5</attribute>
        </item>
        <item>
          <attribute name="label">−12 dB</attribute>
          <attribute name="action">win.clip-volume</attribute>
          <attribute name="target" type="d">0.25</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">Mute</attribute>
          <attribute name="action">win.clip-volume</attribute>
          <attribute name="target" type="d">0.0</attribute>
        </item>
      </submenu>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Add Dissolve</attribute>
        <attribute name="action">win.add-dissolve</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Split at Playhead</attribute>
        <attribute name="action">win.split</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Delete</attribute>
        <attribute name="action">win.delete-clip</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Ripple Delete</attribute>
        <attribute name="action">win.ripple-delete</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Relink Media…</attribute>
        <attribute name="action">win.relink-clip</attribute>
      </item>
    </section>
  </menu>
  <!-- Right-click menu of the ruler; it moves the playhead to the click
       first, so the marks go there. -->
  <menu id="ruler_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Mark In</attribute>
        <attribute name="action">win.set-in</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Mark Out</attribute>
        <attribute name="action">win.set-out</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Add Marker</attribute>
        <attribute name="action">win.add-marker</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Clear In</attribute>
        <attribute name="action">win.clear-in</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Clear Out</attribute>
        <attribute name="action">win.clear-out</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Clear In and Out</attribute>
        <attribute name="action">win.clear-in-out</attribute>
      </item>
    </section>
  </menu>
  <!-- Right-click menu of video track headers; the track.* actions
       work on the track it was opened for. -->
  <menu id="video_track_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Rename Track…</attribute>
        <attribute name="action">track.rename</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Disable Track</attribute>
        <attribute name="action">track.muted</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Lock Track</attribute>
        <attribute name="action">track.locked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Sync Lock</attribute>
        <attribute name="action">track.sync</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Delete Track</attribute>
        <attribute name="action">track.delete</attribute>
      </item>
    </section>
  </menu>
  <!-- Right-click menu of audio track headers; the track.* actions
       work on the track it was opened for. -->
  <menu id="audio_track_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Rename Track…</attribute>
        <attribute name="action">track.rename</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Mute Track</attribute>
        <attribute name="action">track.muted</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Solo Track</attribute>
        <attribute name="action">track.solo</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Lock Track</attribute>
        <attribute name="action">track.locked</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Sync Lock</attribute>
        <attribute name="action">track.sync</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Delete Track</attribute>
        <attribute name="action">track.delete</attribute>
      </item>
    </section>
  </menu>
</interface>
